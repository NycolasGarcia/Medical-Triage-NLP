ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

MODEL_PATH=models/current
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# "sklearn" (padrão, melhor qualidade) ou "onnx" (mais rápido, representação mais
# simples — ver docs/adr/0004-tecnica-otimizacao-latencia.md)
MODEL_BACKEND=sklearn
