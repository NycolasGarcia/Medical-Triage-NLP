{
  "title": "Triagem de Urgência — API",
  "uid": "triagem-urgencia",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Total de requisições (taxa por segundo)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (path, status_code)",
          "legendFormat": "{{method}} {{path}} ({{status_code}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência p50 / p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, path))",
          "legendFormat": "p50 {{path}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, path))",
          "legendFormat": "p95 {{path}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de erro (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_errors_total[1m])) or vector(0)) / sum(rate(http_requests_total[1m]))",
          "legendFormat": "erro %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Distribuição de classes preditas",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(predictions_total) by (label)",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
